# Twilio WhatsApp credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# PostgreSQL connection string (required; set in Render dashboard)
DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a/dbname

# Set to true ONLY for local dev without a database; production must use the database.
ALLOW_IN_MEMORY_FALLBACK=false

# Server Configuration
DEBUG=True
LOG_LEVEL=INFO